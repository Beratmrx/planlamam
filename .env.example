# WhatsApp Cloud API Environment Variables
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle doldurun

# WhatsApp Cloud API Credentials
# Meta Developer Console'dan alınacak: https://developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=planla_webhook_token_2024
