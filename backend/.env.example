# Backend Environment Variables
PORT=3002
NODE_ENV=production
JSON_LIMIT=10mb

# CORS – frontend origin (etkegym.com'dan erişim için)
CORS_ORIGIN=https://etkegym.com

# WhatsApp Cloud API ayarları
# Meta Developer Console'dan alınacak
# (Opsiyonel) VDS'te DNS EAI_AGAIN alıyorsanız graph.facebook.com IP'sini buraya yazın: getent hosts graph.facebook.com
# META_GRAPH_IP=157.240.196.17
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=planla_webhook_token_2024
